[Unit]
Description=restic backup of this machine (primary repo + optional second copy)
Documentation=https://restic.readthedocs.io
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/restic-backup.sh
# systemd provisions /var/cache/restic and exports $CACHE_DIRECTORY; the
# script points RESTIC_CACHE_DIR at it. The unit has no $HOME, and a cacheless
# restic re-downloads repo metadata from the backend on every run.
CacheDirectory=restic
# Be gentle on the Pi / SD card while backing up.
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h
# Least-privilege hardening compatible with what the job does (read the whole
# filesystem, talk to the network, write the restic cache). It runs as root, so
# keep it from escalating further or scribbling on kernel state.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes

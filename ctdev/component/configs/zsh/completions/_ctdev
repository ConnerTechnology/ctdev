#compdef ctdev

_ctdev_components() {
    local -a components
    # Get component names from ctdev itself
    if command -v ctdev &>/dev/null; then
        components=(${(f)"$(ctdev install --help 2>/dev/null | sed -n '/Available components:/,/^$/p' | grep -v 'Available components:' | tr -s ' ' | sed 's/^ *//')"})
        # Fallback: hardcoded list if help parsing fails
        if [[ ${#components[@]} -eq 0 ]]; then
            components=(
                1password age btop bun chatgpt chrome cleanmymac
                claude-code claude-desktop codex dbeaver docker doctl
                earlyoom fonts gh ghostty git git-spice helm jq kubectl
                linear logi-options node ruby shellcheck slack solaar
                sops tailscale terraform tmux vscode zsh
            )
        fi
    fi
    _describe -t components 'component' components
}

_ctdev_configure_targets() {
    local -a targets
    targets=(
        'git:Configure git user (name and email)'
    )
    _describe -t targets 'target' targets
}

_ctdev_configure_git_opts() {
    _arguments -s \
        '--name[Set git user.name]:name' \
        '--email[Set git user.email]:email' \
        '--local[Configure for current repo only]' \
        '--show[Show current git configuration]' \
        '(-h --help)'{-h,--help}'[Show help]'
}

_ctdev_gpu_subcommands() {
    local -a subcommands
    subcommands=(
        'info:Show GPU hardware info and signing status'
        'setup:Configure MOK signing for NVIDIA drivers'
    )
    _describe -t subcommands 'subcommand' subcommands
}

_ctdev() {
    local -a global_flags
    global_flags=(
        '(-h --help)'{-h,--help}'[Show help]'
        '(-v --verbose)'{-v,--verbose}'[Enable verbose output]'
        '(-n --dry-run)'{-n,--dry-run}'[Preview changes without applying]'
        '(-f --force)'{-f,--force}'[Force re-run install scripts]'
        '--version[Show version information]'
    )

    local -a commands
    commands=(
        'install:Install specific components'
        'uninstall:Remove specific components'
        'update:Update system packages and components'
        'info:Show system information'
        'configure:Configure git settings'
        'gpu:Manage GPU driver signing for Secure Boot'
        'setup:Set up and configure your OS'
        'cleanup:Clean up kernels and APT repos'
    )

    _arguments -s \
        "${global_flags[@]}" \
        '1:command:->command' \
        '*::arg:->args'

    case "$state" in
        command)
            _describe -t commands 'ctdev command' commands
            ;;
        args)
            case "${words[1]}" in
                install|uninstall)
                    _arguments -s \
                        "${global_flags[@]}" \
                        '*:component:_ctdev_components'
                    ;;
                update)
                    _arguments -s \
                        "${global_flags[@]}" \
                        '(-y --yes)'{-y,--yes}'[Skip confirmation prompt]' \
                        '--check[List available updates without installing]' \
                        '--refresh-keys[Refresh APT GPG keys before updating]'
                    ;;
                configure)
                    local target="${words[2]}"
                    case "$target" in
                        git) _ctdev_configure_git_opts ;;
                        *) _ctdev_configure_targets ;;
                    esac
                    ;;
                gpu)
                    local gpu_sub="${words[2]}"
                    case "$gpu_sub" in
                        info)
                            _arguments -s \
                                '(-h --help)'{-h,--help}'[Show help]' \
                                '(-v --verbose)'{-v,--verbose}'[Enable verbose output]'
                            ;;
                        setup)
                            _arguments -s \
                                '(-h --help)'{-h,--help}'[Show help]' \
                                '(-v --verbose)'{-v,--verbose}'[Enable verbose output]' \
                                '(-n --dry-run)'{-n,--dry-run}'[Preview changes without applying]' \
                                '(-f --force)'{-f,--force}'[Force re-run even if configured]' \
                                '--recover[Re-enroll MOK key after CMOS reset]'
                            ;;
                        *)
                            _ctdev_gpu_subcommands
                            ;;
                    esac
                    ;;
                setup)
                    _arguments -s \
                        "${global_flags[@]}" \
                        '--show[Show current system configuration]' \
                        '--reset[Reset system configuration to defaults]'
                    ;;
                cleanup)
                    _arguments -s "${global_flags[@]}"
                    ;;
                info)
                    _arguments -s "${global_flags[@]}"
                    ;;
            esac
            ;;
    esac
}

_ctdev "$@"

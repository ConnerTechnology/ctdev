# Caddy reverse proxy. Generic across nodes — the domain and ACME email come
# from the environment (~/caddy/.env, written by `ctdev configure caddy`), so
# this same file works on every node.
{
	email {$HOMELAB_ACME_EMAIL:admin@localhost}
}

# One wildcard cert (*.<domain>) via Cloudflare DNS-01 covers every service.
*.{$HOMELAB_DOMAIN} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	# Pi-hole runs on the host (bare metal), not in a container.
	@pihole host pihole.{$HOMELAB_DOMAIN}
	handle @pihole {
		reverse_proxy host.docker.internal:80
	}

	# Portainer Docker UI, when the 'portainer' component is installed. Serves
	# plain HTTP on 9000 (published to the host) behind this TLS terminator.
	@portainer host portainer.{$HOMELAB_DOMAIN}
	handle @portainer {
		reverse_proxy host.docker.internal:9000
	}

	# Beszel monitoring hub, when the 'beszel' component is installed. Serves
	# plain HTTP on 8090 (published to the host) behind this TLS terminator.
	@beszel host beszel.{$HOMELAB_DOMAIN}
	handle @beszel {
		reverse_proxy host.docker.internal:8090
	}

	# Per-node extra services: drop a *.caddy snippet in ~/caddy/sites/.
	import sites/*.caddy

	handle {
		respond "homelab: no service mapped to this name" 404
	}
}
